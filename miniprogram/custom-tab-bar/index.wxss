.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #FBF7F1;
  border-top: 2rpx solid #E6DCCA;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 10;
}

.item {
  position: relative;
  flex: 1;
  text-align: center;
  padding: 22rpx 0 18rpx;
  color: #8A7E72;
  font-size: 24rpx;
}

.item.on {
  color: #C23A2E;
  font-weight: 700;
}

.badge {
  position: absolute;
  top: 8rpx;
  left: 50%;
  margin-left: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #C23A2E;
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  font-weight: 600;
}
