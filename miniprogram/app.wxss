page {
  background: #F3EEE6;
  color: #1C1712;
  font-size: 30rpx;
  line-height: 1.5;
  font-family: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", sans-serif;
}

.screen {
  padding: 28rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.screen.tab {
  padding-bottom: 200rpx;
}

.logo {
  width: 84rpx;
  height: 84rpx;
  border: 4rpx solid #C23A2E;
  color: #C23A2E;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  transform: rotate(-8deg);
}

.kicker {
  margin-top: 28rpx;
  color: #C23A2E;
  font-size: 24rpx;
  letter-spacing: 6rpx;
}

.h1 {
  margin-top: 8rpx;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.1;
}

.lede {
  margin-top: 16rpx;
  color: #6F645A;
  font-size: 28rpx;
}

.action {
  margin-top: 28rpx;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: #1C1712;
  color: #F6F1E8;
}

.action.help {
  background: #1E6B4F;
}

.action-title {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.action-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.78;
}

.section {
  margin-top: 52rpx;
  color: #8A7E72;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.card {
  position: relative;
  margin-top: 20rpx;
  padding: 28rpx;
  background: #FFFDF9;
  border: 2rpx solid #E6DCCA;
  border-radius: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.4;
  word-break: break-word;
}

.meta {
  margin-top: 12rpx;
  color: #8A7E72;
  font-size: 24rpx;
}

.fresh {
  color: #C23A2E;
}

.chip {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #F8E4E0;
  color: #C23A2E;
  font-size: 22rpx;
}

.label {
  margin: 36rpx 0 12rpx;
  color: #6F645A;
  font-size: 26rpx;
}

.field {
  width: 100%;
  box-sizing: border-box;
  background: #FFFDF9;
  border: 2rpx solid #E6DCCA;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  color: #1C1712;
}

.area {
  height: 180rpx;
}

.pills {
  display: flex;
  margin-bottom: 16rpx;
}

.pill {
  margin-right: 16rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #E6DCCA;
  background: #FFFDF9;
  color: #6F645A;
  font-size: 26rpx;
}

.pill.on {
  background: #1C1712;
  border-color: #1C1712;
  color: #F6F1E8;
}

button.btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin: 28rpx 0 0;
  padding: 0;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  background: #C23A2E;
  color: #fff;
  font-size: 32rpx;
  font-weight: 650;
}

button.btn::after {
  border: none;
}

button.btn.dark {
  background: #1C1712;
}

button.btn.line {
  height: 80rpx;
  line-height: 80rpx;
  background: transparent;
  color: #6F645A;
  font-weight: 500;
  font-size: 28rpx;
}

button.btn.small {
  display: inline-block;
  width: auto;
  margin: 20rpx 16rpx 0 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  font-weight: 500;
}

button.btn.ghost {
  background: transparent;
  color: #C23A2E;
  border: 2rpx solid #C23A2E;
}

button.btn[disabled] {
  opacity: 0.45;
}

button.btn.line[disabled] {
  background: transparent;
  color: #6F645A;
}


.pressed {
  opacity: 0.82;
}

.error {
  margin-top: 20rpx;
  color: #C23A2E;
  font-size: 26rpx;
}

.hint {
  margin-top: 16rpx;
  color: #8A7E72;
  font-size: 24rpx;
  line-height: 1.6;
}

.empty {
  margin-top: 28rpx;
  color: #6F645A;
  font-size: 28rpx;
  line-height: 1.6;
}

.ask {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.45;
  word-break: break-word;
}

.reply {
  position: relative;
}

.reply.stamped {
  padding-right: 150rpx;
  border-color: #E7B2AB;
  background: #FFF8F6;
}

.reply-body {
  font-size: 32rpx;
  line-height: 1.55;
  word-break: break-word;
}

.seal {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  width: 120rpx;
  height: 120rpx;
  box-sizing: border-box;
  border: 6rpx solid rgba(194, 58, 46, 0.85);
  color: rgba(194, 58, 46, 0.9);
  border-radius: 8rpx;
  transform: rotate(-18deg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  white-space: nowrap;
  pointer-events: none;
}

.stats {
  display: flex;
  margin-top: 36rpx;
}

.stat {
  flex: 1;
  padding: 24rpx 0;
  background: #FFFDF9;
  border: 2rpx solid #E6DCCA;
  border-radius: 20rpx;
  text-align: center;
  margin-right: 16rpx;
}

.stat:last-child {
  margin-right: 0;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stat-label {
  margin-top: 6rpx;
  color: #8A7E72;
  font-size: 22rpx;
}

.note.unread {
  border-color: #E7B2AB;
}

.banner {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #EFE7DA;
  color: #6F645A;
  font-size: 26rpx;
}
